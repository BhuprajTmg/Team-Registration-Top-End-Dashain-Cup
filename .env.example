# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets or passwords.

# --- Django core -------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Australia/Darwin

# --- Club / tournament ---------------------------------------------------
CLUB_NAME=Gurkhali FC

# --- Gmail SMTP (auto-reply + organiser notifications) -----------------
# 1. Sign in to the TOURNAMENT'S Gmail account (the one that should send
#    confirmation emails).
# 2. Turn on 2-Step Verification: https://myaccount.google.com/security
# 3. Create an "App password" for Mail:
#    https://myaccount.google.com/apppasswords
#    (Google requires 2-Step Verification to be on before this page is
#    available.) Use the 16-character app password below — NOT your normal
#    Gmail login password. Google shows it as "abcd efgh ijkl mnop"; the
#    spaces are display-only and are ignored either way.
# 4. Leave EMAIL_HOST_USER/EMAIL_HOST_PASSWORD blank to run the site
#    without sending real emails (they'll just print to the console).
# 5. Verify the setup at any time with:
#       python manage.py check_email your-address@gmail.com
EMAIL_HOST_USER=your-tournament-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Seconds to wait for Gmail before giving up on a send.
EMAIL_TIMEOUT=20

# Who gets emailed whenever a new team registers. Defaults to
# EMAIL_HOST_USER if left blank.
ORGANISER_EMAIL=your-tournament-gmail@gmail.com

# Sender name/address shown on outgoing emails. Defaults to
# "<CLUB_NAME> <EMAIL_HOST_USER>" if left blank.
DEFAULT_FROM_EMAIL=Gurkhali FC <your-tournament-gmail@gmail.com>
